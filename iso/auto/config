#!/bin/sh
# live-build auto/config — invoked by `lb config`. Sets distribution
# parameters, image format, and component selection.

set -e

# --mode debian + explicit Debian mirrors: the CI runner is Ubuntu, so
# live-build's default mode/mirrors are Ubuntu's. Without these, `lb config`
# builds an Ubuntu image and debootstrap fails (e.g. dists/precise has no
# Release file). Pin Debian bookworm + deb.debian.org so the build does not
# depend on the host's live-build defaults.
lb config noauto \
    --mode debian \
    --distribution bookworm \
    --architectures amd64 \
    --binary-images iso-hybrid \
    --bootloaders syslinux \
    --linux-flavours amd64 \
    --image-name "anglerfish-ai" \
    --debian-installer false \
    --memtest none \
    --apt-recommends false \
    --security true \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-chroot-security "http://security.debian.org/debian-security/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --mirror-binary-security "http://security.debian.org/debian-security/" \
    --bootappend-live "boot=live components quiet splash" \
    "${@}"
