# Packages installed into the chroot.
# One package per line; comments are stripped by live-build.

# Bootable live system essentials. Without these the ISO does not boot:
#   linux-image-amd64     - the kernel
#   live-boot             - initramfs scripts that mount the live squashfs
#   live-config*          - first-boot live configuration via systemd
#   systemd-sysv          - /sbin/init -> systemd
#   locales               - so LANG=C.UTF-8 resolves and the wizard TTY
#                           renders without locale warnings
linux-image-amd64
live-boot
live-config
live-config-systemd
systemd-sysv
locales

# Install-to-disk: anglerfish-install persists the live appliance to a real
# disk. It needs the partitioning + filesystem + bootloader tooling present
# in the live image (grub-install runs against the target inside a chroot).
gdisk
parted
rsync
dosfstools
grub-pc-bin
grub-efi-amd64-bin
grub-efi-amd64

# Runtime
python3
python3-venv
python3-pip
nftables
openssh-server
# sudo: the first-boot wizard adds the operator account to the sudo group so
# the operator can administer the box (the account is otherwise unprivileged).
sudo
ca-certificates
curl
wget
gpg
# logrotate (+ chattr from e2fsprogs, in base) caps the append-only audit
# log; see /etc/logrotate.d/anglerfish.
logrotate

# Diagnostics
htop
less
vim-tiny
net-tools
iproute2
tcpdump

# Console first-boot wizard needs a usable TTY
console-setup
keyboard-configuration
