#!/usr/bin/env bash
#
# anglerfish-install -- persist the running Anglerfish live appliance to a
# disk, converting it to a normal (non-live) bootable Debian system so all
# captured intel, the wizard secrets, the credentials AES key, the SSH host
# keys, and the append-only audit log survive reboots.
#
# The live image already contains the fully-built appliance (the venv at
# /opt/anglerfish, the systemd units, the firewall), so "install" copies the
# live root filesystem to the target, drops the live-boot machinery,
# regenerates a normal initramfs, and installs GRUB for BIOS + UEFI.
#
# Usage:
#     anglerfish-install [--yes] /dev/sdX
#
# WARNING: this ERASES the target disk. With --yes the confirmation prompt
# is skipped (for automation/testing).
#
# Recommended flow: boot the ISO, complete the first-boot wizard (so its
# config is captured), then run this to persist it; on the next boot the box
# comes up from disk with the wizard already done.

set -euo pipefail

ASSUME_YES=0
TARGET=""
for arg in "$@"; do
    case "${arg}" in
        --yes) ASSUME_YES=1 ;;
        -h|--help) sed -n '2,28p' "$0"; exit 0 ;;
        /dev/*) TARGET="${arg}" ;;
        *) echo "unknown argument: ${arg}" >&2; exit 64 ;;
    esac
done

if [[ "$(id -u)" -ne 0 ]]; then
    echo "anglerfish-install must run as root." >&2
    exit 1
fi
if [[ -z "${TARGET}" || ! -b "${TARGET}" ]]; then
    echo "usage: anglerfish-install [--yes] /dev/sdX   (a whole disk, not a partition)" >&2
    exit 64
fi

# Refuse to install onto the live media itself.
live_src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
if [[ -n "${live_src}" && "${live_src}" == "${TARGET}"* ]]; then
    echo "refusing to install onto the live media (${TARGET})." >&2
    exit 1
fi

# Partition device names: sdX -> sdX1, nvme0n1 -> nvme0n1p1.
partdev() {
    local disk="$1" num="$2"
    if [[ "${disk}" =~ [0-9]$ ]]; then
        echo "${disk}p${num}"
    else
        echo "${disk}${num}"
    fi
}
# Partition 1 is the GRUB BIOS-boot (ef02); grub-install finds it by type,
# so it needs no name here. ESP = 2, root = 3.
P_ESP="$(partdev "${TARGET}" 2)"
P_ROOT="$(partdev "${TARGET}" 3)"

echo "About to ERASE ${TARGET} and install Anglerfish to it:"
lsblk -o NAME,SIZE,TYPE,MOUNTPOINT "${TARGET}" 2>/dev/null || true
if [[ "${ASSUME_YES}" -ne 1 ]]; then
    read -r -p "Type the disk name (${TARGET}) to confirm: " reply
    [[ "${reply}" == "${TARGET}" ]] || { echo "aborted."; exit 1; }
fi

echo "[anglerfish-install] partitioning ${TARGET} (GPT: bios-boot + ESP + root)"
wipefs -a "${TARGET}"
sgdisk --zap-all "${TARGET}"
# 1: BIOS boot (GRUB core.img on GPT for legacy BIOS), 2: ESP (UEFI),
# 3: root (everything else).
sgdisk -n1:0:+1M    -t1:ef02 -c1:"BIOS-boot"        "${TARGET}"
sgdisk -n2:0:+512M  -t2:ef00 -c2:"ESP"              "${TARGET}"
sgdisk -n3:0:0      -t3:8300 -c3:"anglerfish-root"  "${TARGET}"

# Re-read the partition table and wait for the kernel to publish the new
# partition device nodes. A bare partprobe can race on slow media (USB) and
# on loop devices, so retry partx/partprobe until the nodes appear.
wait_for_partitions() {
    for _ in $(seq 1 15); do
        partprobe "${TARGET}" 2>/dev/null || true
        partx -u "${TARGET}" 2>/dev/null || true
        udevadm settle 2>/dev/null || true
        if [[ -b "${P_ESP}" && -b "${P_ROOT}" ]]; then
            return 0
        fi
        sleep 1
    done
    echo "partition nodes ${P_ESP}/${P_ROOT} never appeared after partitioning." >&2
    return 1
}
wait_for_partitions

echo "[anglerfish-install] formatting"
mkfs.vfat -F32 -n ANGLER-ESP "${P_ESP}"
mkfs.ext4 -F -L anglerfish-root "${P_ROOT}"

TGT="/target"
mkdir -p "${TGT}"
mount "${P_ROOT}" "${TGT}"
mkdir -p "${TGT}/boot/efi"
mount "${P_ESP}" "${TGT}/boot/efi"

echo "[anglerfish-install] copying the live root filesystem (this takes a minute)"
rsync -aHAXx \
    --exclude=/proc/ --exclude=/sys/ --exclude=/dev/ --exclude=/run/ \
    --exclude=/tmp/ --exclude=/mnt/ --exclude=/media/ --exclude=/target/ \
    --exclude=/lib/live/ --exclude=/run/live/ \
    --exclude=/var/cache/apt/archives/ \
    / "${TGT}/"

# rsync excluded the pseudo-filesystem and scratch directories entirely, so
# they do not exist on the target. Recreate them as empty mount points; the
# kernel/systemd mount the real filesystems over them at boot, and the chroot
# bind-mounts below need /target/proc etc. to exist.
echo "[anglerfish-install] recreating mount points"
mkdir -p "${TGT}/proc" "${TGT}/sys" "${TGT}/dev" "${TGT}/run" \
         "${TGT}/mnt" "${TGT}/media" "${TGT}/tmp" \
         "${TGT}/var/cache/apt/archives"
chmod 1777 "${TGT}/tmp"

echo "[anglerfish-install] writing fstab"
root_uuid="$(blkid -s UUID -o value "${P_ROOT}")"
esp_uuid="$(blkid -s UUID -o value "${P_ESP}")"
cat > "${TGT}/etc/fstab" <<FSTAB
# Generated by anglerfish-install.
UUID=${root_uuid}  /          ext4  errors=remount-ro  0 1
UUID=${esp_uuid}   /boot/efi  vfat  umask=0077         0 2
FSTAB

echo "[anglerfish-install] converting to a normal-boot system + installing GRUB"
for d in proc sys dev dev/pts run; do
    mount --bind "/${d}" "${TGT}/${d}"
done
cat > "${TGT}/root/.anglerfish-chroot-install.sh" <<'CHROOT'
#!/bin/sh
set -eu
disk="$1"
export DEBIAN_FRONTEND=noninteractive
# Drop the live-only machinery so the initramfs boots from the real root
# instead of looking for live media.
apt-get remove --purge -y \
    live-boot live-boot-initramfs-tools live-config live-config-systemd \
    >/dev/null 2>&1 || true
# live-config regenerated the operator sshd host keys on every live boot;
# with it removed, generate them once here so ssh.service starts on the
# installed box. Doing it at install time gives each deployment unique keys
# (no shared-host-key fingerprint tell across honeypots).
ssh-keygen -A
# Regenerate a normal initramfs for every installed kernel.
update-initramfs -u -k all
# GRUB for UEFI (removable path so it boots without an NVRAM entry) and for
# legacy BIOS (core.img into the ef02 partition + MBR).
grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --recheck
grub-install --target=i386-pc --recheck "${disk}"
update-grub
CHROOT
chroot "${TGT}" /bin/sh /root/.anglerfish-chroot-install.sh "${TARGET}"
rm -f "${TGT}/root/.anglerfish-chroot-install.sh"

echo "[anglerfish-install] syncing + unmounting"
sync
umount -R "${TGT}"

echo
echo "[anglerfish-install] done. Remove the install media and reboot:"
echo "    systemctl reboot"
