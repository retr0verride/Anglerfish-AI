#!/bin/sh
# Copy systemd units into place and enable the first-boot stack.
#
# Both console gettys are masked here so the first-boot wizard owns the
# console on initial boot. The wizard runs on /dev/console, which spans the
# VGA console (tty1) and the serial console (ttyS0); a getty on either would
# race it for input. The wizard's ExecStartPost unmasks + starts both once it
# has successfully written the env file, so the operator gets a console login
# back on second boot (and on every boot thereafter).

set -eu

# Units ship in the app source tree staged at /opt/anglerfish/src by
# config/includes.chroot (same path the venv install uses).
UNIT_SRC=/opt/anglerfish/src/systemd

UNITS="anglerfish-bridge.service anglerfish-dashboard.service \
       anglerfish-lure.service \
       anglerfish-firstboot.service anglerfish-firewall.service \
       anglerfish-audit-shipper.service anglerfish-model-pull.service \
       anglerfish-geo-update.service anglerfish-geo-update.timer"

for unit in ${UNITS}; do
    if [ -f "${UNIT_SRC}/${unit}" ]; then
        install -o root -g root -m 0644 "${UNIT_SRC}/${unit}" \
            "/etc/systemd/system/${unit}"
    fi
done

# Geo database: written by anglerfish-geo (the fetcher unit), read by the
# bridge for lookups. setgid + group-readable so the bridge (group anglerfish)
# can read the .mmdb the fetcher writes.
install -d -o anglerfish-geo -g anglerfish -m 2750 /var/lib/anglerfish/geo

# Lure host-key directory; anglerfish-lure.service generates Ed25519 host keys
# here on first boot via ensure_host_keys(). Private to the lure user.
install -d -o anglerfish-lure -g anglerfish -m 0700 /var/lib/anglerfish/lure-keys

systemctl enable anglerfish-firewall.service
systemctl enable anglerfish-firstboot.service
systemctl enable anglerfish-bridge.service
systemctl enable anglerfish-dashboard.service
systemctl enable anglerfish-lure.service
# Default-off: no-ops (exit 0) until audit.shipper.url is configured, then a
# restart starts streaming the audit log off-box.
systemctl enable anglerfish-audit-shipper.service
# Pulls the configured Ollama models on first boot (no-op without local
# Ollama or for a trusted-remote endpoint).
systemctl enable anglerfish-model-pull.service
systemctl enable anglerfish-geo-update.timer

# First-boot wizard owns /dev/console (tty1 + ttyS0) until it completes (it
# unmasks both gettys in ExecStartPost). Mask them so neither getty races the
# wizard for the console. serial-getty@ttyS0 is auto-generated by
# systemd-getty-generator because console=ttyS0 is on the cmdline, so it must
# be masked explicitly alongside the VGA getty.
systemctl mask getty@tty1.service
systemctl mask serial-getty@ttyS0.service
