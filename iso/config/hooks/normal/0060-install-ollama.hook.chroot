#!/bin/sh
# Optional on-host Ollama install.
#
# Default is trusted-remote: the operator points the bridge at an
# Ollama instance running on a separate GPU box. On-host install is
# opt-in via a build-time environment variable so we do not pay the
# ~5 GB / dbus-requiring install cost by default.
#
# To opt in, export ANGLERFISH_INSTALL_OLLAMA=1 in the live-build
# environment before running ./iso/build.sh. The hook fetches a PINNED
# version of the official installer (TODO-15), so the image is
# reproducible instead of floating to whatever "latest" resolved to at
# build time. The resulting binary is captured in the image and never
# re-fetched at runtime.
#
# Supply-chain note: the upstream installer does NOT checksum-verify the
# binary it downloads, so the binary's integrity rests on HTTPS to
# ollama.com. For a hard pin of the INSTALLER itself, export
# OLLAMA_INSTALL_SHA256 (the sha256 of the v${OLLAMA_VERSION} install.sh,
# computed on a trusted host) before building; a mismatch aborts. A full
# binary pin would require bypassing the upstream installer and is tracked
# as the remainder of TODO-15.
#
# We deliberately avoid pulling a model in the chroot: model bytes are
# large (multi-GB), and the model tags are not known until the wizard runs.
# Instead anglerfish-model-pull.service pulls the configured models on first
# boot once the wizard has captured them (TODO-14).

set -e

if [ "${ANGLERFISH_INSTALL_OLLAMA:-0}" != "1" ]; then
    echo "[anglerfish] on-host Ollama install skipped (default: trusted-remote)."
    echo "[anglerfish] set ANGLERFISH_INSTALL_OLLAMA=1 at build time to opt in."
    exit 0
fi

# live-build hooks run with network access by default; guard the offline
# case so the failure message is helpful.
if ! command -v curl >/dev/null 2>&1; then
    echo "[anglerfish] curl missing; cannot fetch the Ollama installer." >&2
    exit 1
fi

# Pinned release. Bump deliberately (and re-verify OLLAMA_INSTALL_SHA256 on
# a trusted host) rather than tracking "latest".
OLLAMA_VERSION="0.30.3"
script_url="https://github.com/ollama/ollama/releases/download/v${OLLAMA_VERSION}/install.sh"
script_path="/tmp/ollama-install-${OLLAMA_VERSION}.sh"

echo "[anglerfish] fetching pinned Ollama installer v${OLLAMA_VERSION}..."
# Download to a file first (no blind 'curl | sh'), so it can be checksum-
# gated and inspected before execution.
curl --fail --silent --show-error --location -o "${script_path}" "${script_url}"

if [ -n "${OLLAMA_INSTALL_SHA256:-}" ]; then
    if ! echo "${OLLAMA_INSTALL_SHA256}  ${script_path}" | sha256sum -c - >/dev/null 2>&1; then
        echo "[anglerfish] Ollama installer checksum mismatch; aborting." >&2
        exit 1
    fi
    echo "[anglerfish] installer checksum verified."
else
    echo "[anglerfish] WARNING: OLLAMA_INSTALL_SHA256 unset: version is pinned" >&2
    echo "[anglerfish] but the installer is not checksum-verified." >&2
fi

# The v${OLLAMA_VERSION} Linux binary ships as a .tar.zst, and the upstream
# installer hard-requires zstd to extract it (it errors out and exits
# otherwise). The base chroot has no zstd, so pull it here. This stays on
# the opt-in path, so the default --without-ollama image is not burdened.
if ! command -v zstd >/dev/null 2>&1; then
    echo "[anglerfish] installing zstd (required to extract the Ollama .tar.zst)..."
    # live-build clears the chroot apt lists after the package-list install
    # and before hooks run, so refresh the index first or zstd has no
    # installation candidate. Scoped to the opt-in path, so the default
    # --without-ollama image neither installs zstd nor re-fetches the index.
    apt-get update
    apt-get install -y --no-install-recommends zstd
fi

echo "[anglerfish] installing Ollama v${OLLAMA_VERSION} on-host (operator opted in)..."
# install.sh appends ?version=$OLLAMA_VERSION to its download URLs, pinning
# the binary version to match the script. In a chroot `systemctl
# is-system-running` reports offline, so the installer writes the binary,
# ollama user, and unit file but skips the service start (we enable it below).
OLLAMA_VERSION="${OLLAMA_VERSION}" sh "${script_path}"
rm -f "${script_path}"

# Ollama's installer writes /etc/systemd/system/ollama.service. Enable
# it so the bridge can reach 127.0.0.1:11434 after the wizard finishes.
# The service starts on multi-user.target alongside the bridge.
if [ -f /etc/systemd/system/ollama.service ]; then
    systemctl enable ollama.service
fi
