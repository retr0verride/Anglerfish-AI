[Unit]
Description=Anglerfish AI — refresh MaxMind GeoLite2 databases
Documentation=https://github.com/retr0verride/Anglerfish-AI
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/anglerfish/anglerfish.env

[Service]
Type=oneshot
User=anglerfish-geo
Group=anglerfish
EnvironmentFile=/etc/anglerfish/anglerfish.env
ExecStart=/opt/anglerfish/venv/bin/anglerfish geo update

# Hardening — this unit downloads files and writes them to the geo
# database directory. It needs network access and write access to one
# directory, nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Hide the host's other-user processes and non-pid /proc surfaces from
# a compromised service (full per-service-user isolation is TODO-17's
# remaining piece; see docs/TODO.md).
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Pin the seccomp filter to the native ABI (the @system-service allowlist
# is otherwise ABI-bypassable). The fetcher only needs IP sockets.
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6
# Group-accessible so the bridge (group anglerfish) can read the geo DB and
# append to the shared audit log.
UMask=0007
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/anglerfish/geo /var/log/anglerfish
PrivateDevices=yes
