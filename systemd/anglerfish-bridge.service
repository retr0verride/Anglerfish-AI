[Unit]
Description=Anglerfish AI bridge — LLM middleware for the native SSH lure
Documentation=https://github.com/retr0verride/Anglerfish-AI
# Fail closed on the firewall: do not start the bridge if the nftables
# ruleset failed to load.
After=network-online.target anglerfish-firewall.service ollama.service anglerfish-model-pull.service
Requires=anglerfish-firewall.service
# Soft-order after the first-boot model pull so the model is present before
# the bridge serves; a pull failure does not block the bridge (it falls back).
Wants=network-online.target anglerfish-model-pull.service

[Service]
Type=exec
User=anglerfish
Group=anglerfish
EnvironmentFile=/etc/anglerfish/anglerfish.env
ExecStart=/opt/anglerfish/venv/bin/anglerfish bridge serve --host 127.0.0.1 --port 8421
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s

# Hardening — the bridge is reachable from the lure on the bait host
# and processes attacker-controlled content; lock it down accordingly.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Pin the seccomp filter to the native ABI; a secondary x32/i386 ABI would
# otherwise bypass the @system-service allowlist.
SystemCallArchitectures=native
# Only the socket families the service actually uses.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
RemoveIPC=yes
# Resource ceilings: a flood cannot OOM / fd-exhaust the box. Conservative
# defaults; raise per deployment.
MemoryMax=1G
TasksMax=512
LimitNOFILE=8192
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/anglerfish /var/log/anglerfish
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
