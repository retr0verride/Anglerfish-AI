[Unit]
Description=Anglerfish AI first-boot Ollama model pull (TODO-14)
Documentation=https://github.com/retr0verride/Anglerfish-AI
After=network-online.target ollama.service anglerfish-firstboot.service
Wants=network-online.target
# Only meaningful once the wizard has captured the model tags. A no-op
# (exit 0) when Ollama is a trusted remote or not installed.
ConditionPathExists=/etc/anglerfish/anglerfish.env

[Service]
Type=oneshot
RemainAfterExit=yes
User=anglerfish
Group=anglerfish
EnvironmentFile=/etc/anglerfish/anglerfish.env
ExecStart=/opt/anglerfish/venv/bin/anglerfish ollama pull
# Model pulls are large and unbounded; the puller retries internally, so do
# not impose a start timeout.
TimeoutStartSec=infinity

# Hardening. The puller only talks to the local Ollama API on loopback; the
# Ollama daemon performs the registry download.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Hide the host's other-user processes and non-pid /proc surfaces from
# a compromised service (full per-service-user isolation is TODO-17's
# remaining piece; see docs/TODO.md).
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
RemoveIPC=yes
MemoryMax=256M
TasksMax=64
LimitNOFILE=4096
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
