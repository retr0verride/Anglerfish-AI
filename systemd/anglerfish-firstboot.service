[Unit]
Description=Anglerfish AI first-boot configuration wizard
Documentation=https://github.com/retr0verride/Anglerfish-AI
After=network-online.target
ConditionPathExists=!/etc/anglerfish/anglerfish.env
DefaultDependencies=no
Before=anglerfish-bridge.service anglerfish-dashboard.service multi-user.target

[Service]
Type=oneshot
RemainAfterExit=no
StandardInput=tty
StandardOutput=tty
StandardError=tty
# Run on /dev/console, not /dev/tty1. The cmdline registers console=tty0
# console=ttyS0 (see iso/auto/config), so /dev/console takes input from the
# serial line (ttyS0, reachable via `qm terminal`) and mirrors output to the
# VGA console (tty0, the Proxmox noVNC view). The operator drives the wizard
# as stable serial text; noVNC is a readable fallback. TERM=vt220 gives Rich
# a sane terminal type on the serial line so prompts render cleanly.
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
Environment=TERM=vt220
ExecStart=/opt/anglerfish/venv/bin/anglerfish-wizard --env /etc/anglerfish/anglerfish.env

# Re-enable the console logins once the wizard completes successfully so the
# operator can log in for diagnostics. The chroot hook masks both gettys at
# image-build time so the wizard owns the console on first boot; we undo that
# here. getty@tty1 is the VGA login (noVNC); serial-getty@ttyS0 is the serial
# login (`qm terminal`). Only runs when ExecStart returned 0 (Type=oneshot's
# success contract).
ExecStartPost=/bin/systemctl unmask getty@tty1.service serial-getty@ttyS0.service
ExecStartPost=/bin/systemctl start getty@tty1.service serial-getty@ttyS0.service

# Schedule the MaxMind GeoLite2 update once the wizard has written the
# license key into the env file. The fetch unit no-ops if the key is
# absent (operator skipped that prompt).
ExecStartPost=/bin/systemctl start anglerfish-geo-update.service

# Lock the audit log to append-only at the filesystem level. The wizard
# has just written its first record so the file exists. `chattr +a` only
# works on ext2/3/4, btrfs and xfs; on other filesystems the command
# fails harmlessly and the audit log remains append-only by convention.
# Once set, the attribute persists in the inode across reboots — this
# only needs to fire on first boot.
#
# Leading `-` makes the whole step non-fatal: an unsupported filesystem
# or chmod failure must not abort firstboot.
ExecStartPost=-/bin/sh -c 'install -d -m 2770 -o anglerfish -g anglerfish /var/log/anglerfish && touch /var/log/anglerfish/audit.jsonl && chown anglerfish:anglerfish /var/log/anglerfish/audit.jsonl && chmod 0660 /var/log/anglerfish/audit.jsonl && chattr +a /var/log/anglerfish/audit.jsonl 2>/dev/null || true'

# Bring the appliance online without a reboot. anglerfish-firewall is
# ConditionPathExists-skipped at boot (its ruleset does not exist until the
# wizard writes it), so it stays inactive rather than failing -- which
# keeps the Requires=anglerfish-firewall.service chain from dependency-
# failing the bridge/lure/dashboard. Those services are ordered
# After=anglerfish-firstboot.service, so they sit queued through the
# wizard. Now that the wizard has written the ruleset, env and per-NIC
# .network files: apply the NIC config, load the firewall (its condition is
# now satisfied), then start the stack. The firewall restart is synchronous
# so the services find it active; --no-block on the services so firstboot
# does not wait on the bridge's model-pull. On every later boot this unit
# is skipped (ConditionPathExists=!env) and the firewall loads early and
# normally because the ruleset now exists.
ExecStartPost=-/bin/networkctl reload
ExecStartPost=/bin/systemctl restart anglerfish-firewall.service
ExecStartPost=/bin/systemctl start --no-block anglerfish-bridge.service anglerfish-dashboard.service anglerfish-lure.service

[Install]
WantedBy=multi-user.target
